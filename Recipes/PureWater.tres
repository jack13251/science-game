[resource]
script = ExtResource("1_bg2ed")
recipe_name = "Water Distillation"
inputs = Array[String](["Impure Water"])
output = "Pure Water"
description = "Water containing chemical and mineral impurities (such as that from a tap) is heated until it evaporates into steam leaving the impurities behind. The steam is then condensed into pure water."
